{
  "id": "map",
  "name": "Map",
  "description": "OpenStreetMap with preset landmarks — tap to drop your own pins",
  "version": "1.0.1",
  "icon": "icon.svg",
  "allowedCommands": [],
  "network": true,
  "chrome": "full",
  "cli": {
    "summary": "OSM map of Grodno with tappable markers and zoom controls",
    "events": [
      {
        "id": "zoom_in",
        "description": "Increase zoom level"
      },
      {
        "id": "zoom_out",
        "description": "Decrease zoom level"
      },
      {
        "id": "map_tap",
        "description": "Drop a pin (payload: {lat, lng})"
      },
      {
        "id": "marker_tap",
        "description": "Show marker details (payload: {id})"
      },
      {
        "id": "select_<id>",
        "description": "Center on a marker and show details"
      },
      {
        "id": "remove_<id>",
        "description": "Remove a user pin"
      }
    ],
    "read": {
      "state": "yoloit app:state map — zoom, markerCount, selected",
      "snapshot": "yoloit app:snapshot map — full render JSON tree"
    },
    "examples": [
      "yoloit app:run map",
      "yoloit app:execute map zoom_in",
      "yoloit app:execute map map_tap '{\"lat\":53.68,\"lng\":23.84}'",
      "yoloit app:state map"
    ]
  },
  "author": "Fa",
  "license": "MIT",
  "minRuntime": "0.4.79",
  "tags": [
    "maps"
  ]
}
